generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  HR
  MEMBER
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
}

// Rodzaj kanału tekstowego. ANNOUNCEMENT działa jak discordowy kanał
// ogłoszeniowy: czytają wszyscy, pisać mogą wyłącznie administratorzy kanału.
enum ChannelKind {
  TEXT
  ANNOUNCEMENT
}

enum ChannelRole {
  ADMIN
  MEMBER
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  require2fa     Boolean      @default(false)
  messageRetentionDays Int?   // null = keep forever
  allowedEmailDomains  String? // comma-separated, null = any domain
  encryptAtRest  Boolean      @default(false) // AES-256-GCM on message content at rest (server-side)
  createdAt      DateTime     @default(now())
  members        Membership[]
  channels       Channel[]
  channelCategories ChannelCategory[]
  invites        Invite[]
  auditLogs      AuditLog[]
  roles          Role[]
  modules        OrganizationModule[]
  documents      Document[]

  @@map("organizations")
}

/**
 * Per-organization module toggle (F7). Only stores explicit overrides for
 * OPTIONAL modules; a missing row means "use default" (enabled). Core modules
 * are never persisted here. When the org is linked to the wb-platform Hub,
 * these rows are synced from the Hub's Entitlements API.
 */
model OrganizationModule {
  id        String   @id @default(uuid())
  orgId     String
  moduleKey String
  enabled   Boolean  @default(true)
  source    String   @default("local") // "local" | "hub"
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleKey])
  @@index([orgId])
  @@map("organization_modules")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String? // deprecated, unused — see avatarKey (S3 object key, resolved via presigned URL)
  avatarKey    String?
  jobTitle     String?
  department   String?
  phone        String?
  statusText   String?
  statusEmoji  String?
  statusExpiresAt DateTime?
  notifyMode   NotifyMode @default(ALL)
  emailDigest  EmailDigestMode @default(MENTIONS)
  totpSecret   String? // AES-256-GCM ciphertext, never plaintext
  totpEnabled  Boolean   @default(false)
  publicKey    String? // X25519 identity key, E2EE phase 2
  isSuperAdmin Boolean   @default(false) // platform-level god-mode (F5-H): manage orgs/memberships across the whole install, independent of any single org's roles
  deletedAt    DateTime? // account deletion: user row kept (anonymized) for referential integrity of past messages
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships    Membership[]
  channelMembers ChannelMember[]
  messages       Message[]
  sessions       Session[]
  recoveryCodes  RecoveryCode[]
  dataExports    DataExport[]
  pushSubscriptions PushSubscription[]
  scheduledMessages ScheduledMessage[]
  reminders      Reminder[]
  pollVotes      PollVote[]

  @@map("users")
}

model ScheduledMessage {
  id        String    @id @default(uuid())
  channelId String
  authorId  String
  content   String
  sendAt    DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sendAt])
  @@index([authorId])
  @@map("scheduled_messages")
}

model Reminder {
  id        String    @id @default(uuid())
  userId    String
  messageId String
  channelId String
  note      String?
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@index([userId])
  @@map("reminders")
}

/// A poll attached to exactly one message. `hideVoters` is decided at creation
/// time and is irreversible on purpose: promising voters that nobody will see
/// their choice and then revealing it later would be a betrayal. Note the flag
/// hides identities from the API and UI, it does not make the ballot
/// cryptographically anonymous — the vote rows still reference the user, which
/// is what makes "one vote per person" and un-voting possible at all.
model Poll {
  id        String       @id @default(uuid())
  messageId String       @unique
  question  String
  allowMultiple Boolean  @default(false)
  hideVoters Boolean     @default(false)
  closesAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime     @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@map("polls")
}

model PollOption {
  id       String     @id @default(uuid())
  pollId   String
  text     String
  emoji    String?
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id           String   @id @default(uuid())
  pollOptionId String
  userId       String
  createdAt    DateTime @default(now())

  option PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

enum NotifyMode {
  ALL
  MENTIONS
  NONE
}

/// Zakres zbiorczych powiadomien e-mail. Domyslnie MENTIONS: mail przychodzi
/// tylko dla wzmianek i wiadomosci bezposrednich, czyli tam gdzie milczenie
/// realnie kosztuje. ALL obejmuje kazdy kanal, ktory nie jest wyciszony.
enum EmailDigestMode {
  OFF
  MENTIONS
  ALL
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Membership {
  id           String    @id @default(uuid())
  userId       String
  orgId        String
  role         OrgRole   @default(MEMBER)
  customRoleId String?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customRole Role?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([customRoleId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  color       String   @default("#8b5cf6")
  permissions String[]
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("roles")
}

model Invite {
  id        String   @id @default(uuid())
  orgId     String
  email     String
  role      OrgRole  @default(MEMBER)
  tokenHash String   @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invites")
}

// Kategoria kanałów — odpowiednik discordowej kategorii. Grupuje kanały
// w bocznym pasku i wyznacza kolejność wyświetlania w obrębie organizacji.
model ChannelCategory {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@index([orgId, position])
  @@map("channel_categories")
}

model Channel {
  id         String      @id @default(uuid())
  orgId      String
  type       ChannelType
  kind       ChannelKind @default(TEXT)
  name       String?
  topic      String?
  createdBy  String
  categoryId String? // null = kanał poza kategoriami, u góry listy
  position   Int         @default(0) // kolejność w obrębie kategorii, wspólna dla całej organizacji
  slowmodeSeconds Int    @default(0) // 0 = wyłączony; minimalny odstęp między wiadomościami jednego autora
  e2ee       Boolean     @default(false) // end-to-end encryption enabled (DM only); content is client-side ciphertext
  messageTtlSeconds Int? // disappearing messages: purge messages older than this (null = off)
  archivedAt DateTime?
  createdAt  DateTime    @default(now())

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members ChannelMember[]
  messages Message[]
  integrationWebhooks IntegrationWebhook[]
  documents Document[]

  @@index([orgId])
  @@index([orgId, categoryId, position])
  @@map("channels")
}

model ChannelMember {
  id         String      @id @default(uuid())
  channelId  String
  userId     String
  role       ChannelRole @default(MEMBER)
  lastReadAt DateTime?
  mutedAt    DateTime?
  favorite   Boolean     @default(false)
  /// PRZESTARZAŁE: kolejność kanałów jest teraz wspólna dla organizacji
  /// (Channel.position + ChannelCategory.position). Kolumna zostaje do czasu
  /// potwierdzenia wdrożenia, żeby ewentualne cofnięcie kodu nie wywróciło API.
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

/// Incoming integration webhook (F7-I): an external system POSTs JSON to a
/// per-channel URL (authenticated by an unguessable token, stored hashed)
/// and the payload is posted into the channel as a bot user. Gated by the
/// `integrations` module.
model IntegrationWebhook {
  id           String    @id @default(uuid())
  orgId        String
  channelId    String
  name         String
  tokenHash    String    @unique
  botUserId    String?
  enabled      Boolean   @default(true)
  createdById  String
  messageCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([orgId])
  @@map("integration_webhooks")
}

model Message {
  id          String    @id @default(uuid())
  channelId   String
  authorId    String
  content     String
  contentType String    @default("text")
  encrypted   Boolean   @default(false) // content stored AES-256-GCM encrypted (org at-rest encryption)
  parentId    String?
  pinnedAt    DateTime?
  pinnedBy    String?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  files   File[]
  embeds  LinkEmbed[]
  reactions Reaction[]
  savedBy SavedMessage[]
  poll    Poll?

  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([channelId, pinnedAt])
  @@map("messages")
}

model SavedMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@map("saved_messages")
}

enum FileStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model File {
  id           String     @id @default(uuid())
  orgId        String
  channelId    String
  uploaderId   String
  messageId    String?
  key          String     @unique
  name         String
  mimeType     String
  size         Int
  encrypted    Boolean    @default(false) // client-side encrypted (E2E): server holds opaque ciphertext only
  status       FileStatus @default(PENDING)
  width        Int?
  height       Int?
  thumbKey     String?
  previewKey   String?
  previewStatus String    @default("NONE") // NONE | PENDING | READY | FAILED
  createdAt    DateTime   @default(now())

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([messageId])
  @@map("files")
}

model LinkEmbed {
  id          String   @id @default(uuid())
  messageId   String
  url         String
  title       String?
  description String?
  imageKey    String?
  siteName    String?
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("link_embeds")
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("reactions")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshHash  String    @unique
  familyId     String // rotation family, revoked together on reuse detection
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

model DataExport {
  id             String       @id @default(uuid())
  orgId          String? // null = personal cross-org export ("/me/export")
  requestedById  String
  targetUserId   String
  status         ExportStatus @default(PENDING)
  key            String? // S3 object key of the finished zip
  error          String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  targetUser User @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("data_exports")
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String
  actorId   String?
  action    String
  meta      Json     @default("{}")
  ip        String?
  // Tamper-evident hash chain: prevHash links each entry to the previous
  // one for this org, so a DB-level edit/delete breaks the chain visibly.
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

/// Shared document pinned to a channel (F8). Access follows channel
/// membership: there is no separate document ACL, so a document is readable
/// and editable by exactly the people who can already read the channel.
model Document {
  id         String    @id @default(uuid())
  orgId      String
  channelId  String
  title      String
  icon       String?
  createdBy  String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel   Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  blocks    DocumentBlock[]
  revisions DocumentRevision[]
  comments  DocumentComment[]

  @@index([channelId, updatedAt])
  @@index([orgId])
  @@map("documents")
}

/// One ordered unit of a document (heading, paragraph, table, checklist,
/// divider). `data` holds the type-specific payload, validated against a
/// discriminated union before every write. `version` powers the optimistic
/// concurrency check: a save carrying a stale version is refused, so two
/// people editing the same block never silently overwrite each other.
model DocumentBlock {
  id          String   @id @default(uuid())
  documentId  String
  type        String
  position    Int
  data        Json
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments DocumentComment[]

  @@index([documentId, position])
  @@map("document_blocks")
}

/// Point-in-time snapshot of every block, written before a change when the
/// previous snapshot is stale or came from a different author. Lets the team
/// see what a document looked like earlier and roll back to it.
model DocumentRevision {
  id         String   @id @default(uuid())
  documentId String
  authorId   String?
  summary    String
  snapshot   Json
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_revisions")
}

/// Comment on a document, optionally anchored to one block. Deleting the
/// block keeps the comment on the document (blockId becomes null) so the
/// discussion is not lost together with the content it referred to.
model DocumentComment {
  id         String    @id @default(uuid())
  documentId String
  blockId    String?
  authorId   String
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  block    DocumentBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@map("document_comments")
}
